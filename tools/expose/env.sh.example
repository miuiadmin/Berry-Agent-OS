#!/usr/bin/env bash
# =============================================================================
# BerryAgent 外网映射 · 方案 A：SSH 反向隧道配置
# =============================================================================
# 用法：
#   1. 复制本文件：cp tools/expose/env.sh.example tools/expose/env.sh
#   2. 编辑下面的变量，填入你的服务器信息
#   3. 跑：source tools/expose/env.sh && tools/expose/tunnel.sh up
# =============================================================================

# --- 必填：你的云服务器 ---
# 服务器 SSH 连接（user@host:port）
export BERRY_TUNNEL_SSH_TARGET="user@your.server.ip"

# 服务器 SSH 端口（默认 22）
export BERRY_TUNNEL_SSH_PORT="${BERRY_TUNNEL_SSH_PORT:-22}"

# --- 必填：服务器上要开的对外端口 ---
# 选个 10000-65535 之间的数，避免和常见服务冲突
# 例如 18080、28080、38880 都行
export BERRY_TUNNEL_REMOTE_PORT="${BERRY_TUNNEL_REMOTE_PORT:-18080}"

# --- Mac 端 BerryAgent 监听的本地端口（一般不用改）---
export BERRY_LOCAL_PORT="${BERRY_LOCAL_PORT:-3888}"

# --- SSH 隧道监听地址 ---
# 0.0.0.0 = 服务器所有网卡都监听（GatewayPorts=yes 必需）
# 127.0.0.1 = 只服务器本机可访问（更安全，外网访问需配合 nginx 反代）
export BERRY_TUNNEL_BIND="${BERRY_TUNNEL_BIND:-0.0.0.0}"

# --- autossh 重连参数 ---
export BERRY_TUNNEL_KEEPALIVE_INTERVAL="${BERRY_TUNNEL_KEEPALIVE_INTERVAL:-30}"
export BERRY_TUNNEL_KEEPALIVE_COUNT="${BERRY_TUNNEL_KEEPALIVE_COUNT:-3}"

# --- 可选：SSH 私钥路径（默认 ~/.ssh/id_ed25519）---
export BERRY_TUNNEL_SSH_KEY="${BERRY_TUNNEL_SSH_KEY:-$HOME/.ssh/id_ed25519}"

# --- 可选：连接别名（用于多服务器场景）---
export BERRY_TUNNEL_NAME="${BERRY_TUNNEL_NAME:-berry-main}"

# =============================================================================
# 派生变量（不要改）
# =============================================================================
export BERRY_TUNNEL_AUTOSSH_PID="/tmp/berry-tunnel-${BERRY_TUNNEL_NAME}.autossh.pid"
export BERRY_TUNNEL_SSH_PID="/tmp/berry-tunnel-${BERRY_TUNNEL_NAME}.ssh.pid"
export BERRY_TUNNEL_LOG="/tmp/berry-tunnel-${BERRY_TUNNEL_NAME}.log"

# 拼接 ssh 目标 user@host（去掉可能的 :port）
BERRY_TUNNEL_SSH_BASE="${BERRY_TUNNEL_SSH_TARGET%:*}"
export BERRY_TUNNEL_SSH_BASE

# 派生：最终访问 URL（提示用）
export BERRY_PUBLIC_URL="http://${BERRY_TUNNEL_SSH_BASE#*@}:${BERRY_TUNNEL_REMOTE_PORT}"
