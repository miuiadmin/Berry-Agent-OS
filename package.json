{
  "name": "berryagent",
  "version": "0.2.0",
  "description": "Dual self-evolving AI personal assistant",
  "type": "module",
  "bin": {
    "berry": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "find src/agents/bundled -name 'agent.json' -exec sh -c 'dest=\"dist/${0#src/}\"; mkdir -p \"$(dirname \"$dest\")\"; cp \"$0\" \"$dest\"' {} \\;",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "node tools/check-boundaries.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@anthropic-ai/sdk": "^0.98.0",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.191",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
