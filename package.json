{
  "name": "berryagent",
  "version": "1.0.0-alpha.0",
  "description": "Berry Agent OS — 跑 AI 应用的个人操作系统（1.0 重置线；设计见 设计文档/01-规范/）",
  "type": "module",
  "private": true,
  "bin": {
    "berry": "./dist/app/main.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx src/app/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:topology": "node tools/check-topology.mjs && node tools/check-events.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tools/**/*.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "better-sqlite3": "^12.10.0",
    "ignore": "^7.0.6",
    "jiti": "^2",
    "typebox": "1.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
