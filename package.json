{
  "name": "berry-agent-os",
  "version": "1.0.0-alpha.1",
  "codename": "Peiligang",
  "description": "Berry Agent OS — 跑 AI 应用的操作系统",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miuiadmin/Berry-Agent-OS.git"
  },
  "keywords": [
    "ai-agent",
    "agent-runtime",
    "agent-os",
    "llm",
    "cli",
    "tui",
    "assistant",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "berry": "./dist/app/main.js"
  },
  "files": [
    "dist",
    "examples",
    "apps",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/app/main.ts --debug",
    "dev:webui": "vite dev -c src/webui/client/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build -c src/webui/client/vite.config.ts && node tools/copy-app-assets.mjs && node tools/write-build-meta.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webui/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:topology": "node tools/check-topology.mjs && node tools/check-events.mjs && node tools/check-tense.mjs",
    "release": "node tools/release.mjs",
    "prepare": "node tools/install-hooks.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"src/webui/client/**/*.tsx\" \"tools/**/*.mjs\" \"README*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/webui/client/**/*.tsx\" \"tools/**/*.mjs\" \"README*.md\" \"docs/**/*.md\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "better-sqlite3": "13.0.3",
    "ignore": "^7.0.8",
    "jiti": "^2",
    "typebox": "^1.3.25",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19"
  }
}
