{
  // API 面声明产物构建配置（契约篇 §6.13.9 dist/api/，第八十七批批 2 + API 治理
  // 进化刀 B CR2① 扩面）：为应用沙箱 tsc 产六虚拟键 .d.ts 的**生成半边**——只做
  // 声明发射（emitDeclarationOnly），产 dist/contracts/*.d.ts（公开根传递闭包）
  // + dist/llm/provider-face.d.ts + dist/persist/app-sqlite.d.ts（第五/六键类型
  // 锚）。六键 d.ts 本体（api-decls/手稳件）由 tools/emit-api-decls.mjs 拷入
  // dist/api/ 并对相对引用锚定核验。
  // 刀 B 扩面（§6.13.4）：include 增列 18 服务面契约接口的宿主模块根（face
  // 接口声明位——chat/session/app/skills/safety/web/channels/browser/compaction
  // 各模块 + llm/complete），发射面覆盖全部 faceInterface 声明块——刀 C 签名
  // 指纹的方法符号声明块源即取自本发射产物（services 域方法级符号的 .d.ts
  // 切片底座）。主构建（tsconfig.build.json 零声明纪律）不变——本配置是独立
  // 子步，非覆盖。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/llm/provider-face.ts",
    "src/llm/complete.ts",
    "src/persist/app-sqlite.ts",
    "src/session/service-face.ts",
    "src/app/composition.ts",
    "src/app/apps.ts",
    "src/skills/types.ts",
    "src/safety/approval.ts",
    "src/safety/sandbox.ts",
    "src/web/types.ts",
    "src/channels/types.ts",
    "src/browser/app.ts",
    "src/compaction/app.ts",
    "src/chat/app.ts"
  ]
}
